{
  "manifest_version": 3,
  "name": "Utagoe - Japanese Lyrics Romaji",
  "version": "1.0.0",
  "description": "Shows Romaji transliteration stacked directly above the original Kanji/Kana lyrics on Spotify Web Player and YouTube Music.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://music.youtube.com/*",
    "https://lrclib.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "lib/kuroshiro.min.js",
        "lib/kuroshiro-analyzer-kuromoji.min.js",
        "content/ateji.js",
        "content/validator.js",
        "content/sites/spotify.js",
        "content/sites/youtubemusic.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dict/*",
        "lib/*"
      ],
      "matches": [
        "https://open.spotify.com/*",
        "https://music.youtube.com/*"
      ]
    }
  ]
}
